---
import { doctorConfig as defaultConfig } from "../data/config.js";

type Sede = {
  ciudad: string;
  nombre: string;
  direccion: string;
  dias: string;
  horario: string;
  telefono: string;
  mapaUrl: string;
};

type DoctorConfig = {
  sedes: Sede[];
};

const { config = defaultConfig }: { config?: DoctorConfig } = Astro.props;
---

<section id="ubicaciones" class="locations-section">
  <div class="container">
    <div class="section-header">
      <span class="sub-title">Sedes de Consulta</span>
      <h2>¿Dónde Puedes Encontrarnos?</h2>
      <p>Atención presencial en múltiples centros de salud con fácil acceso y estacionamiento.</p>
    </div>

    <div class="locations-grid">
      {config.sedes.map((sede : Sede) => (
        <div class="location-card">
          <div class="card-header">
            <span class="city-badge">{sede.ciudad}</span>
            <h3>{sede.nombre}</h3>
            <p class="address">📍 {sede.direccion}</p>
          </div>

          <div class="card-body">
            <div class="info-row">
              <span class="label">📅 Días de atención:</span>
              <span class="value">{sede.dias}</span>
            </div>
            <div class="info-row">
              <span class="label">⏰ Horario:</span>
              <span class="value">{sede.horario}</span>
            </div>
            <div class="info-row">
              <span class="label">📞 Teléfono directo:</span>
              <span class="value">{sede.telefono}</span>
            </div>
          </div>

          <div class="card-footer">
            <a href={sede.mapaUrl} target="_blank" class="btn-outline">Ver en Google Maps</a>
            <a href="#agendar" class="btn-primary-sm">Agendar en esta sede</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .locations-section {
    padding: 5rem 0;
    background-color: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3.5rem auto;
  }

  .sub-title {
    color: var(--primary);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0.5rem 0;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .location-card {
    background-color: var(--bg-light);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .city-badge {
    background-color: #e0f2fe;
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .location-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0.75rem 0 0.25rem 0;
  }

  .address {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }

  .card-body {
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
    padding: 1.25rem 0;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
  }

  .label {
    color: var(--text-muted);
    font-weight: 500;
  }

  .value {
    color: var(--text-dark);
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    gap: 1rem;
  }

  .btn-outline {
    flex: 1;
    text-align: center;
    border: 1px solid var(--border);
    background-color: var(--white);
    color: var(--text-dark);
    padding: 0.65rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .btn-outline:hover {
    background-color: #f1f5f9;
  }

  .btn-primary-sm {
    flex: 1;
    text-align: center;
    background-color: var(--primary);
    color: white;
    padding: 0.65rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background-color 0.2s;
  }

  .btn-primary-sm:hover {
    background-color: var(--primary-hover);
  }
</style>