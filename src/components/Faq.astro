---
import { doctorConfig } from '../data/config.js';
---

<section id="faq" class="faq-section">
  <div class="container">
    <div class="section-header">
      <span class="sub-title">Dudas Comunes</span>
      <h2>Preguntas Frecuentes</h2>
      <p>Información rápida sobre la dinámica de consulta y métodos de atención.</p>
    </div>

    <div class="faq-list">
      {doctorConfig.faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{faq.pregunta}</span>
            <span class="arrow">↓</span>
          </summary>
          <p class="faq-answer">{faq.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 5rem 0;
    background-color: var(--white);
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .sub-title {
    color: var(--primary);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0.5rem 0;
  }

  .section-header p {
    color: var(--text-muted);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: var(--bg-light);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    transition: background-color 0.2s;
  }

  .faq-item[open] {
    background-color: var(--white);
    border-color: var(--primary);
  }

  .faq-question {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-dark);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none; /* Oculta el marcador por defecto de <details> */
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .arrow {
    color: var(--primary);
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .arrow {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }
</style>