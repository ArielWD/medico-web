---
import { doctorConfig as defaultConfig } from "../data/config.js";
const { config = defaultConfig } = Astro.props;
---

<section id="servicios" class="services-section">
  <div class="container">
    <!-- Encabezado de la Sección -->
    <div class="section-header">
      <span class="sub-title">Atención Integral</span>
      <h2>Servicios y Especialidades Médicas</h2>
      <p>Diagnósticos precisos y tratamientos personalizados para cuidar de tu corazón.</p>
    </div>

    <!-- Grid Dinámico de Tarjetas -->
    <div class="services-grid">
    {config.servicios.map((servicio: { icon: string; title: string; description: string }) => (
      <div class="service-card">
        <div class="icon-wrapper">{servicio.icon}</div>
        <h3>{servicio.title}</h3>
        <p>{servicio.description}</p>
        <a href="#agendar" class="card-link">Agendar para este servicio →</a>
      </div>
    ))}
  </div>
  </div>
</section>

<style>
  .services-section {
    padding: 5rem 0;
    background-color: var(--bg-light);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3.5rem auto;
  }

  .sub-title {
    color: var(--primary);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0.5rem 0;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  /* Grid Responsive */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .service-card {
    background-color: var(--white);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.05);
  }

  .icon-wrapper {
    font-size: 2rem;
    background-color: #f0f9ff;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    margin-bottom: 1.25rem;
  }

  .service-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 0.75rem;
  }

  .service-card p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1; /* Para que todos los botones queden alineados abajo */
  }

  .card-link {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--primary-hover);
  }
</style>