---
// ⚠️ COMPONENTE SOLO PARA LA DEMO.
// Al entregar el sitio a un cliente real, elimina este archivo y su
// referencia en index.astro (no depende de doctorConfig, así que no
// rompe nada del sitio del cliente).
import { demoConfig } from '../data/config.js';

const mensaje = encodeURIComponent(demoConfig.mensajePrellenado);
const whatsappUrl = `https://wa.me/${demoConfig.whatsappNumero}?text=${mensaje}`;
---

<div class="demo-banner" id="demoBanner">
  <div class="demo-banner-content">
    <p>
      <strong>¿Te gustó esta web?</strong> Así se vería la tuya —
      hecha por <span class="brand">{demoConfig.marca}</span>.
    </p>
    <div class="demo-banner-actions">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="demo-cta">
        Hablemos por WhatsApp
      </a>
      <button class="demo-close" id="demoBannerClose" aria-label="Cerrar aviso">✕</button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('demoBanner');
  const closeBtn = document.getElementById('demoBannerClose');

  // Se recuerda solo durante la sesión: si cierran el banner y navegan por
  // el sitio, no vuelve a molestar. Si vuelven en otra visita, aparece de nuevo.
  if (banner) {
    if (sessionStorage.getItem('demoBannerClosed') === '1') {
      banner.style.display = 'none';
    }

    closeBtn?.addEventListener('click', () => {
      banner.style.display = 'none';
      sessionStorage.setItem('demoBannerClosed', '1');
    });
  }
</script>

<style>
  .demo-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background-color: #0f172a;
    color: #f8fafc;
    padding: 0.85rem 1.25rem;
    box-shadow: 0 -6px 20px -5px rgba(0, 0, 0, 0.25);
  }

  .demo-banner-content {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .demo-banner-content p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: #e2e8f0;
  }

  .demo-banner-content strong {
    color: #ffffff;
  }

  .brand {
    color: #38bdf8;
    font-weight: 700;
  }

  .demo-banner-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .demo-cta {
    background-color: #25d366;
    color: #ffffff;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .demo-cta:hover {
    background-color: #1ebe5b;
  }

  .demo-close {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.4rem;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .demo-close:hover {
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .demo-banner-content {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      gap: 0.85rem;
    }

    .demo-banner-actions {
      justify-content: center;
    }

    .demo-cta {
      flex: 1;
      text-align: center;
    }
  }
</style>
