---
import { doctorConfig } from '../data/config.js';
---

<section id="sobre-mi" class="about-section">
  <div class="container about-grid">
    <div class="about-image">
      <img 
        src={doctorConfig.fotoSobreMi} 
        alt="Doctor en consultorio" 
      />
    </div>

    <div class="about-content">
      <h2>{doctorConfig.nombre}</h2>
        <p class="bio">
            {doctorConfig.bio}
        </p>

      <ul class="achievements-list">
        {doctorConfig.logros.map((item) => (
          <li>
            <span class="check">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 5rem 0;
    background-color: var(--blue);
    border-bottom: 1px solid var(--border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-image img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: right;
    border-radius: 16px;
  }

  h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0.5rem 0 1rem 0;
  }

  .bio {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .achievements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .achievements-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-dark);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .check {
    color: var(--primary);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>