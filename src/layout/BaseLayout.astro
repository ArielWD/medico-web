---
// src/layouts/BaseLayout.astro
import { doctorConfig } from '../data/config.js';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${doctorConfig.nombre} | ${doctorConfig.especialidad}`, 
  description = doctorConfig.descripcionHero 
} = Astro.props;

// Obtener la URL canónica dinámica
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://medico-web.pages.dev');
const ogImageUrl = new URL('/og-image.png', canonicalURL).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / WhatsApp / Facebook / Instagram -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- Carga de la fuente Plus Jakarta Sans (Muy usada en interfaces médicas modernas) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- <slot /> es la ventana donde se renderizará el contenido de cada página -->
    <slot />
  </body>
</html>

<style is:global>
  /* Variables de Color y Reset Básico */
  :root {
    --primary: #0284c7;        /* Azul médico accesibilidad AA */
    --primary-hover: #0369a1;  /* Azul oscuro para hover */
    --text-dark: #0f172a;      /* Color texto principal */
    --text-muted: #475569;     /* Color texto secundario */
    --bg-light: #f8fafc;       /* Fondo neutro claro */
    --white: #ffffff;
    --blue: #56c5e0;
    --border: #e2e8f0;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text-dark);
    background-color: var(--bg-light);
    line-height: 1.5;
  }

  a {
    text-decoration: none;
    color: inherit;
  }
</style>